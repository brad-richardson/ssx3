@@ -0,0 +1,78 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+//
+// SSX 3 (GXBE69) host-side course redirect.
+//
+// The frontend's event table lives in the DOL's data5 section and is only ever
+// *read* by the game: the world archive filename, the SDB location code, the
+// two menu strings, the per-event topology row's location id and the event
+// mode word are all plain data. Rewriting them in guest RAM after the DOL
+// image is loaded and before the CPU starts therefore redirects an event to a
+// different course without changing a byte of sys/main.dol -- the pinned
+// dol_sha256 stays valid and the recompiled module needs no regeneration
+// (the module only hashes *code* chunks, which this never touches).
+//
+// Driven by a host-side manifest named by SSX_COURSE_MANIFEST. No manifest,
+// no patching, and the hook is inert for every other game.
+//
+// Live apply (no reset) reuses the same manifest parser, the same 69-word
+// table re-verify and the same per-write logging through
+// ApplyCourseManifestLive. It must run on a controlled host thread while the
+// caller holds Core::CPUThreadGuard -- the pause point -- so no guest read
+// can tear across the multi-byte string writes. It never pokes while a ride
+// is loaded (RideLoaded): a mid-ride switch stays queued and applies once the
+// rider is gone, i.e. after quit-to-frontend. See docs/course-selection.md,
+// "Live apply".
+
+#pragma once
+
+#include <string>
+
+namespace Core
+{
+class System;
+}
+
+namespace SSX3
+{
+// Applies SSX_COURSE_MANIFEST to guest RAM. Call once per guest boot, after the
+// DOL sections are in memory and before execution starts. Returns false only
+// when a manifest was requested and could not be applied.
+bool ApplyCourseManifest(Core::System& system);
+
+enum class LiveApplyResult
+{
+  Applied,            // the manifest is in guest RAM
+  DeferredRideLoaded, // a ride is loaded; nothing was written
+  Failed,             // a manifest was requested and could not be applied
+  NoPending,          // ApplyPendingCourseManifest only: the queue is empty
+};
+
+// True while a ride is loaded: the first-rider pointer chain resolves inside
+// MEM1 and the rider has a finite, sane, nonzero position. Menus keep the
+// rider at exactly (0,0,0), so that pose reads as no ride. Best-effort guest
+// peek; call with Core::CPUThreadGuard held.
+bool RideLoaded(Core::System& system);
+
+// Re-applies a manifest to the live event table. Guarded by RideLoaded and by
+// the same table re-verify as the boot hook. Call with Core::CPUThreadGuard
+// held, on a controlled host thread -- never a polling thread.
+LiveApplyResult ApplyCourseManifestLive(Core::System& system, const std::string& manifest_path);
+
+// Deferred queue for switches filed mid-ride. ApplyPendingCourseManifest
+// attempts the queued manifest: Applied and Failed both drain the queue (a
+// manifest that cannot parse must not wedge it), DeferredRideLoaded keeps it
+// for a later attempt. Call with Core::CPUThreadGuard held.
+LiveApplyResult ApplyPendingCourseManifest(Core::System& system);
+
+// Host-side queue bookkeeping. Thread-safe, no guard needed.
+void QueueCourseManifest(std::string manifest_path);
+void ClearPendingCourseManifest();
+bool HasPendingCourseManifest();
+
+// Desktop trigger (docs/course-selection.md "Live apply"): consumes an
+// SSX_COURSE_REQUEST file -- first line names a manifest, "stock" clears the
+// queue -- into the pending queue. Returns false when there is no request to
+// consume. Thread-safe, no guard needed; the queued switch still applies under
+// the guard through ApplyPendingCourseManifest.
+bool ConsumeCourseRequestFile(const char* request_path);
+}  // namespace SSX3
diff --git a/Source/Core/Core/Boot/Ssx3CoursePatch.cpp b/Source/Core/Core/Boot/Ssx3CoursePatch.cpp
