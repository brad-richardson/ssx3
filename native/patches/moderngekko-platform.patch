+
+// Host-side handling of GXBE69 (SSX 3) SDK cache-range calls and the system
+// call vector, executed by the recompiler core without any per-dispatch cost
+// (see StaticRecompModuleSource::return_hooks). Dolphin runs with data-cache
+// emulation off, so DCFlushRange and friends only cost time: one native
+// dispatch per cache line plus a trailing `sc` whose vector body toggles HID0
+// around a sync. The core verifies the first and last instruction words of
+// every hooked entry before handling it; a different executable falls
+// through to the original code. Disable with SSX3_HOST_HLE=0.
+namespace ssx3_hle {
+constexpr std::array<StaticRecompModuleSource::HostReturnHook, 6> kReturns{{
+    {0x80284DA4u, 0x28040000u, 0x28u}, // DCInvalidateRange
+    {0x80284DD0u, 0x28040000u, 0x2Cu}, // DCFlushRange
+    {0x80284E00u, 0x28040000u, 0x2Cu}, // DCStoreRange
+    {0x80284E30u, 0x28040000u, 0x28u}, // DCFlushRangeNoSync
+    {0x80284E5Cu, 0x28040000u, 0x28u}, // DCStoreRangeNoSync
+    {0x8028342Cu, 0x44000002u, 0x04u}, // sc; blr helper
+}};
+
+bool Enabled() {
+  static const bool on = [] {
+    const char *value = std::getenv("SSX3_HOST_HLE");
+    return !(value && std::strcmp(value, "0") == 0);
+  }();
+  return on;
+}
+
+void Install(StaticRecompModuleSource &source) {
+  source.return_hooks.assign(kReturns.begin(), kReturns.end());
+  source.emulate_syscall_vector = true;
+}
+} // namespace ssx3_hle
