+// An idled AX task can leave the pushed stream sitting at a nonzero constant
+// for seconds (stale init / stale DMA frame, varying per occasion); phone
+// speakers turn that pedestal into audible static between menu sounds. A
+// first-order blocker (R=0.995, ~38 Hz cutoff at 48 kHz) settles a stuck
+// constant to silence in ~4 ms and is inaudible for real content.
+void CoreAudioSound::BlockDC(s16* samples, UInt32 frames)
+{
+  for (UInt32 i = 0; i < frames; ++i)
+  {
+    for (int ch = 0; ch < 2; ++ch)
+    {
+      const float x = samples[i * 2 + ch];
+      float& prev_x = ch == 0 ? m_dc_prev_x_l : m_dc_prev_x_r;
+      float& prev_y = ch == 0 ? m_dc_prev_y_l : m_dc_prev_y_r;
+      const float y = x - prev_x + 0.995f * prev_y;
+      prev_x = x;
+      prev_y = y;
+      samples[i * 2 + ch] = static_cast<s16>(std::clamp(y, -32768.0f, 32767.0f));
+    }
+  }
+}
