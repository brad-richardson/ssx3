-static const auto MC_TRANSFER_RATE_WRITE = static_cast<u32>(96.125f * 1024.0f);
+// Real hardware read rate. SSX 3 scans the card before its main menu, and at
+// 512 KiB/s that scan is several seconds of purely modelled delay on a device
+// with no card to be slow. SSX3_MEMCARD_READ_SPEEDUP divides the modelled read
+// time by its value; completion still runs through the same CoreTiming events in
+// the same order, so only the delay changes.
+//
+// Writes are deliberately left at hardware rate: save durability depends on the
+// game seeing the write complete when it expects to, and nothing about the boot
+// wait is improved by rushing them.
+// Read per call rather than cached in a static: a card DMA happens a handful of
+// times per boot, so parsing is free, and caching would freeze the value for the
+// whole process - meaning a changed setting needed a relaunch rather than the
+// Full Reset the UI promises.
+static u32 MemcardRate(const char* variable, u32 base)
+{
+  const char* env = std::getenv(variable);
+  if (!env)
+    return base;
+  const double factor = std::atof(env);
+  if (!(factor >= 1.0) || factor > 1024.0)
+    return base;
+  return static_cast<u32>(base * factor);
+}
+
+// How much of a boot the modelled card latency actually accounts for, which is
+// the only way to tell a card wait from the game's own timers. Printed once at
+// shutdown next to the other runtime counters.
+struct MemcardTraffic
+{
+  u64 reads = 0, read_bytes = 0, read_ticks = 0;
+  u64 writes = 0, write_bytes = 0, write_ticks = 0;
+};
+static MemcardTraffic s_traffic;
+
+void ReportMemcardTraffic(u32 ticks_per_second)
+{
+  if (!s_traffic.reads && !s_traffic.writes)
+  {
+    std::fprintf(stderr, "[ssx3-memcard] no card traffic\n");
+    return;
+  }
+  const double rate = ticks_per_second ? static_cast<double>(ticks_per_second) : 1.0;
+  std::fprintf(stderr,
+               "[ssx3-memcard] reads=%llu bytes=%llu modelled=%.3fs | "
+               "writes=%llu bytes=%llu modelled=%.3fs\n",
+               static_cast<unsigned long long>(s_traffic.reads),
+               static_cast<unsigned long long>(s_traffic.read_bytes),
+               s_traffic.read_ticks / rate,
+               static_cast<unsigned long long>(s_traffic.writes),
+               static_cast<unsigned long long>(s_traffic.write_bytes),
+               s_traffic.write_ticks / rate);
+}
+#define MC_TRANSFER_RATE_READ (MemcardRate("SSX3_MEMCARD_READ_SPEEDUP", 512 * 1024))
+#define MC_TRANSFER_RATE_WRITE \
+  (MemcardRate("SSX3_MEMCARD_WRITE_SPEEDUP", static_cast<u32>(96.125f * 1024.0f)))
 
