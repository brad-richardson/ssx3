diff --git a/CMakeLists.txt b/CMakeLists.txt
index 9f837ec..61306fd 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -224,8 +224,19 @@ elseif(_ARCH_64 AND CMAKE_SYSTEM_PROCESSOR MATCHES "x64|x86_64|amd64|AMD64")
 elseif(_ARCH_64 AND CMAKE_SYSTEM_PROCESSOR MATCHES "aarch64|arm64|ARM64")
   set(_M_ARM_64 1)
   add_definitions(-D_M_ARM_64=1)
-  # CRC instruction set is used in the CRC32 hash function
-  check_and_add_flag(HAVE_ARCH_ARMV8 -march=armv8-a+crc)
+  # NOTE(android-lse): same target-system test as the android headless/egl
+  # patches (ENABLE_HEADLESS sets the ANDROID var to 0): the Snapdragon 8
+  # Elite is armv9, so build the Android runtime for armv8.2 with LSE
+  # atomics emitted inline instead of the baseline armv8-a+crc with outline
+  # __aarch64_* helpers. Desktop aarch64 builds keep the baseline flags.
+  if(ANDROID OR (ENABLE_HEADLESS AND CMAKE_SYSTEM_NAME STREQUAL "Android"))
+    # CRC instruction set is used in the CRC32 hash function
+    check_and_add_flag(HAVE_ARCH_ARMV8_LSE -march=armv8.2-a+crc+lse)
+    check_and_add_flag(HAVE_NO_OUTLINE_ATOMICS -mno-outline-atomics)
+  else()
+    # CRC instruction set is used in the CRC32 hash function
+    check_and_add_flag(HAVE_ARCH_ARMV8 -march=armv8-a+crc)
+  endif()
 else()
   message(FATAL_ERROR "You're building on an unsupported platform: "
       "'${CMAKE_SYSTEM_PROCESSOR}' with ${CMAKE_SIZEOF_VOID_P}-byte pointers."
