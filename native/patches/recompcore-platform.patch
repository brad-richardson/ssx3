diff --git a/GXRuntime/include/core/cpu_fast_fp.h b/GXRuntime/include/core/cpu_fast_fp.h
new file mode 100644
index 0000000..1a59985
--- /dev/null
+++ b/GXRuntime/include/core/cpu_fast_fp.h
@@ -0,0 +1,294 @@
+/* Inline floating-point fast paths for generated chunks.
+ *
+ * Forced-included (-include) before each generated chunk when the module is
+ * built with RECOMPCORE_FAST_FP. Function-like macros redirect the chunk's
+ * calls to the arithmetic helpers below; every other translation unit,
+ * including the interpreter and the helpers themselves, is unchanged.
+ *
+ * Value semantics for finite operands are exactly the helpers': the same
+ * double-precision operation, the same 25-bit rounding of the C operand for
+ * multiplies, the same single rounding, the same NI flush of tiny results.
+ * A NaN result, or any enabled FPSCR exception (VE/OE/UE/ZE/XE), falls back
+ * to the exact helper so payload propagation and exception state stay the
+ * same. What the fast path deliberately omits is FPSCR bookkeeping for
+ * non-exceptional results: FPRF classification, FI/FR and sticky inexact,
+ * zero-divide and invalid flags. That matches Dolphin's JIT defaults (FPRF
+ * off, AccurateNaNs off), which is the accuracy every Dolphin user runs.
+ */
+#pragma once
+#include "core/cpu.h"
+#include <math.h>
+#include <string.h>
+
+#define GX_FASTFP_INLINE static inline __attribute__((always_inline))
+#define GX_FASTFP_UNLIKELY(x) __builtin_expect(!!(x), 0)
+#define GX_FASTFP_ANY_E 0xF8u  /* VE OE UE ZE XE */
+#define GX_FASTFP_NI 0x04u
+
+GX_FASTFP_INLINE u64 gx_fastfp_bits(f64 v) { u64 b; memcpy(&b, &v, 8); return b; }
+GX_FASTFP_INLINE f64 gx_fastfp_f64(u64 b) { f64 v; memcpy(&v, &b, 8); return v; }
+GX_FASTFP_INLINE bool gx_fastfp_strict(const CPUState* cpu) { return (cpu->fpscr & GX_FASTFP_ANY_E) != 0; }
+
+/* force_single: NI flushes |value| < 2^-126 to a signed zero, then rounds. */
+GX_FASTFP_INLINE f32 gx_fastfp_force_single(const CPUState* cpu, f64 value) {
+    if (cpu->fpscr & GX_FASTFP_NI) {
+        const u64 bits = gx_fastfp_bits(value);
+        if ((bits & 0x7FFFFFFFFFFFFFFFull) < 0x3810000000000000ull) {
+            const u32 flushed = (u32)((bits & 0x8000000000000000ull) >> 32);
+            f32 r; memcpy(&r, &flushed, 4); return r;
+        }
+    }
+    return (f32)value;
+}
+
+/* force_25bit_c: C-operand rounding used by fmuls and the paired-single ops. */
+GX_FASTFP_INLINE f64 gx_fastfp_force_25bit_c(f64 d) {
+    u64 integral = gx_fastfp_bits(d);
+    const u64 exponent = integral & 0x7FF0000000000000ull;
+    const u64 fraction = integral & 0x000FFFFFFFFFFFFFull;
+    if (exponent == 0 && fraction != 0) {
+        s64 keep_mask = (s64)0xFFFFFFFFF8000000ll;
+        u64 round = 0x8000000u;
+        const unsigned shift = (unsigned)__builtin_clzll(fraction) - 11u;
+        keep_mask >>= shift;
+        round >>= shift;
+        integral = (integral & (u64)keep_mask) + (integral & round);
+    } else {
+        integral = (integral & 0xFFFFFFFFF8000000ull) + (integral & 0x8000000ull);
+    }
+    return gx_fastfp_f64(integral);
+}
+
+/* force_25_bit: C-operand rounding used by the scalar fused multiply-add. */
+GX_FASTFP_INLINE f64 gx_fastfp_force_25_bit(f64 value) {
+    u64 bits = gx_fastfp_bits(value);
+    const u64 fraction = bits & 0x000FFFFFFFFFFFFFull;
+    u64 keep_mask = 0xFFFFFFFFF8000000ull;
+    u64 round = 0x0000000008000000ull;
+    if ((bits & 0x7FF0000000000000ull) == 0 && fraction != 0) {
+        const unsigned shift = (unsigned)__builtin_clzll(fraction) - 11u;
+        if (shift < 28) {
+            keep_mask = ~((1ull << (27 - shift)) - 1);
+            round >>= shift;
+        } else {
+            keep_mask = ~0ull;
+            round = 0;
+        }
+    }
+    bits = (bits & keep_mask) + (bits & round);
+    return gx_fastfp_f64(bits);
+}
+
+/* Single-precision fused multiply-add as ni_madd_msub computes it (value only). */
+GX_FASTFP_INLINE f64 gx_fastfp_madd_single(f64 a, f64 c, f64 b, bool sub) {
+    const f64 c_round = gx_fastfp_force_25bit_c(c);
+    const f64 b_sign = sub ? -b : b;
+    f64 result = fma(a, c_round, b_sign);
+    const u64 result_bits = gx_fastfp_bits(result);
+    if ((result_bits & 0x000000001FFFFFFFull) == 0x0000000010000000ull) {
+        const f64 a_prime = b_sign - result;
+        const f64 b_prime = result + a_prime;
+        const f64 error = fma(a, c_round, a_prime) + (b_sign - b_prime);
+        if (error != 0.0)
+            result = gx_fastfp_f64(((error > 0.0) == (result > 0.0)) ? result_bits + 1 : result_bits - 1);
+    }
+    return result;
+}
+
+GX_FASTFP_INLINE void gx_fastfp_write_single(CPUState* cpu, u8 d, f32 v) {
+    cpu->fpr[d] = (f64)v;
+    cpu->ps1[d] = (f64)v;
+}
+GX_FASTFP_INLINE void gx_fastfp_write_both(CPUState* cpu, u8 d, f32 ps0, f32 ps1) {
+    cpu->fpr[d] = (f64)ps0;
+    cpu->ps1[d] = (f64)ps1;
+}
+
+/* ---- scalar single ---- */
+GX_FASTFP_INLINE void gx_fastfp_fadds(CPUState* cpu, u8 d, u8 a, u8 b) {
+    if (GX_FASTFP_UNLIKELY(gx_fastfp_strict(cpu))) { ppc_fadds(cpu, d, a, b); return; }
+    const f64 r = cpu->fpr[a] + cpu->fpr[b];
+    if (GX_FASTFP_UNLIKELY(isnan(r))) { ppc_fadds(cpu, d, a, b); return; }
+    gx_fastfp_write_single(cpu, d, gx_fastfp_force_single(cpu, r));
+}
+GX_FASTFP_INLINE void gx_fastfp_fsubs(CPUState* cpu, u8 d, u8 a, u8 b) {
+    if (GX_FASTFP_UNLIKELY(gx_fastfp_strict(cpu))) { ppc_fsubs(cpu, d, a, b); return; }
+    const f64 r = cpu->fpr[a] - cpu->fpr[b];
+    if (GX_FASTFP_UNLIKELY(isnan(r))) { ppc_fsubs(cpu, d, a, b); return; }
+    gx_fastfp_write_single(cpu, d, gx_fastfp_force_single(cpu, r));
+}
+GX_FASTFP_INLINE void gx_fastfp_fmuls(CPUState* cpu, u8 d, u8 a, u8 c) {
+    if (GX_FASTFP_UNLIKELY(gx_fastfp_strict(cpu))) { ppc_fmuls(cpu, d, a, c); return; }
+    const f64 r = cpu->fpr[a] * gx_fastfp_force_25bit_c(cpu->fpr[c]);
+    if (GX_FASTFP_UNLIKELY(isnan(r))) { ppc_fmuls(cpu, d, a, c); return; }
+    gx_fastfp_write_single(cpu, d, gx_fastfp_force_single(cpu, r));
+}
+GX_FASTFP_INLINE void gx_fastfp_fdivs(CPUState* cpu, u8 d, u8 a, u8 b) {
+    if (GX_FASTFP_UNLIKELY(gx_fastfp_strict(cpu))) { ppc_fdivs(cpu, d, a, b); return; }
+    const f64 r = cpu->fpr[a] / cpu->fpr[b];
+    if (GX_FASTFP_UNLIKELY(isnan(r))) { ppc_fdivs(cpu, d, a, b); return; }
+    gx_fastfp_write_single(cpu, d, gx_fastfp_force_single(cpu, r));
+}
+GX_FASTFP_INLINE void gx_fastfp_frsp(CPUState* cpu, u8 d, u8 b) {
+    const f64 value = cpu->fpr[b];
+    if (GX_FASTFP_UNLIKELY(gx_fastfp_strict(cpu) || isnan(value))) { ppc_frsp(cpu, d, b); return; }
+    gx_fastfp_write_single(cpu, d, gx_fastfp_force_single(cpu, value));
+}
+
+/* ---- scalar double ---- */
+GX_FASTFP_INLINE void gx_fastfp_fadd(CPUState* cpu, u8 d, u8 a, u8 b) {
+    if (GX_FASTFP_UNLIKELY(gx_fastfp_strict(cpu))) { ppc_fadd(cpu, d, a, b); return; }
+    const f64 r = cpu->fpr[a] + cpu->fpr[b];
+    if (GX_FASTFP_UNLIKELY(isnan(r))) { ppc_fadd(cpu, d, a, b); return; }
+    cpu->fpr[d] = r;
+}
+GX_FASTFP_INLINE void gx_fastfp_fsub(CPUState* cpu, u8 d, u8 a, u8 b) {
+    if (GX_FASTFP_UNLIKELY(gx_fastfp_strict(cpu))) { ppc_fsub(cpu, d, a, b); return; }
+    const f64 r = cpu->fpr[a] - cpu->fpr[b];
+    if (GX_FASTFP_UNLIKELY(isnan(r))) { ppc_fsub(cpu, d, a, b); return; }
+    cpu->fpr[d] = r;
+}
+GX_FASTFP_INLINE void gx_fastfp_fmul(CPUState* cpu, u8 d, u8 a, u8 c) {
+    if (GX_FASTFP_UNLIKELY(gx_fastfp_strict(cpu))) { ppc_fmul(cpu, d, a, c); return; }
+    const f64 r = cpu->fpr[a] * cpu->fpr[c];
+    if (GX_FASTFP_UNLIKELY(isnan(r))) { ppc_fmul(cpu, d, a, c); return; }
+    cpu->fpr[d] = r;
+}
+GX_FASTFP_INLINE void gx_fastfp_fdiv(CPUState* cpu, u8 d, u8 a, u8 b) {
+    if (GX_FASTFP_UNLIKELY(gx_fastfp_strict(cpu))) { ppc_fdiv(cpu, d, a, b); return; }
+    const f64 r = cpu->fpr[a] / cpu->fpr[b];
+    if (GX_FASTFP_UNLIKELY(isnan(r))) { ppc_fdiv(cpu, d, a, b); return; }
+    cpu->fpr[d] = r;
+}
+
+/* ---- fused multiply-add, generated form: returns whether output was written ---- */
+GX_FASTFP_INLINE bool gx_fastfp_fma(CPUState* cpu, f64 a, f64 c, f64 b, bool single,
+                                    bool subtract, bool negative, f64* output) {
+    if (GX_FASTFP_UNLIKELY(gx_fastfp_strict(cpu)))
+        return ppc_fma(cpu, a, c, b, single, subtract, negative, output);
+    const f64 addend = subtract ? -b : b;
+    f64 result;
+    if (!single) {
+        result = fma(a, c, addend);
+    } else {
+        const f64 rounded_c = gx_fastfp_force_25_bit(c);
+        result = fma(a, rounded_c, addend);
+        u64 bits = gx_fastfp_bits(result);
+        if ((bits & 0x000000001FFFFFFFull) == 0x0000000010000000ull) {
+            const f64 a_prime = addend - result;
+            const f64 b_prime = result + a_prime;
+            const f64 error = fma(a, rounded_c, a_prime) + (addend - b_prime);
+            if (error != 0.0) {
+                if ((error > 0.0) == (result > 0.0)) bits++;
+                else bits--;
+                result = gx_fastfp_f64(bits);
+            }
+        }
+        result = (f64)(f32)result;
+    }
+    if (GX_FASTFP_UNLIKELY(isnan(result)))
+        return ppc_fma(cpu, a, c, b, single, subtract, negative, output);
+    *output = negative ? -result : result;
+    return true;
+}
+
+/* ---- paired single ---- */
+GX_FASTFP_INLINE void gx_fastfp_ps_add(CPUState* cpu, u8 d, u8 a, u8 b) {
+    if (GX_FASTFP_UNLIKELY(gx_fastfp_strict(cpu))) { ppc_ps_add_op(cpu, d, a, b); return; }
+    const f64 r0 = cpu->fpr[a] + cpu->fpr[b], r1 = cpu->ps1[a] + cpu->ps1[b];
+    if (GX_FASTFP_UNLIKELY(isnan(r0) || isnan(r1))) { ppc_ps_add_op(cpu, d, a, b); return; }
+    gx_fastfp_write_both(cpu, d, gx_fastfp_force_single(cpu, r0), gx_fastfp_force_single(cpu, r1));
+}
+GX_FASTFP_INLINE void gx_fastfp_ps_sub(CPUState* cpu, u8 d, u8 a, u8 b) {
+    if (GX_FASTFP_UNLIKELY(gx_fastfp_strict(cpu))) { ppc_ps_sub_op(cpu, d, a, b); return; }
+    const f64 r0 = cpu->fpr[a] - cpu->fpr[b], r1 = cpu->ps1[a] - cpu->ps1[b];
+    if (GX_FASTFP_UNLIKELY(isnan(r0) || isnan(r1))) { ppc_ps_sub_op(cpu, d, a, b); return; }
+    gx_fastfp_write_both(cpu, d, gx_fastfp_force_single(cpu, r0), gx_fastfp_force_single(cpu, r1));
+}
+GX_FASTFP_INLINE void gx_fastfp_ps_mul(CPUState* cpu, u8 d, u8 a, u8 c) {
+    if (GX_FASTFP_UNLIKELY(gx_fastfp_strict(cpu))) { ppc_ps_mul_op(cpu, d, a, c); return; }
+    const f64 r0 = cpu->fpr[a] * gx_fastfp_force_25bit_c(cpu->fpr[c]);
+    const f64 r1 = cpu->ps1[a] * gx_fastfp_force_25bit_c(cpu->ps1[c]);
+    if (GX_FASTFP_UNLIKELY(isnan(r0) || isnan(r1))) { ppc_ps_mul_op(cpu, d, a, c); return; }
+    gx_fastfp_write_both(cpu, d, gx_fastfp_force_single(cpu, r0), gx_fastfp_force_single(cpu, r1));
+}
+GX_FASTFP_INLINE void gx_fastfp_ps_div(CPUState* cpu, u8 d, u8 a, u8 b) {
+    if (GX_FASTFP_UNLIKELY(gx_fastfp_strict(cpu))) { ppc_ps_div_op(cpu, d, a, b); return; }
+    const f64 r0 = cpu->fpr[a] / cpu->fpr[b], r1 = cpu->ps1[a] / cpu->ps1[b];
+    if (GX_FASTFP_UNLIKELY(isnan(r0) || isnan(r1))) { ppc_ps_div_op(cpu, d, a, b); return; }
+    gx_fastfp_write_both(cpu, d, gx_fastfp_force_single(cpu, r0), gx_fastfp_force_single(cpu, r1));
+}
+GX_FASTFP_INLINE void gx_fastfp_ps_madd(CPUState* cpu, u8 d, u8 a, u8 c, u8 b, bool subtract, bool negative) {
+    if (GX_FASTFP_UNLIKELY(gx_fastfp_strict(cpu))) { ppc_ps_madd_op(cpu, d, a, c, b, subtract, negative); return; }
+    const f64 t0 = gx_fastfp_madd_single(cpu->fpr[a], cpu->fpr[c], cpu->fpr[b], subtract);
+    const f64 t1 = gx_fastfp_madd_single(cpu->ps1[a], cpu->ps1[c], cpu->ps1[b], subtract);
+    if (GX_FASTFP_UNLIKELY(isnan(t0) || isnan(t1))) { ppc_ps_madd_op(cpu, d, a, c, b, subtract, negative); return; }
+    f32 ps0 = gx_fastfp_force_single(cpu, t0), ps1 = gx_fastfp_force_single(cpu, t1);
+    if (negative) { ps0 = -ps0; ps1 = -ps1; }
+    gx_fastfp_write_both(cpu, d, ps0, ps1);
+}
+GX_FASTFP_INLINE void gx_fastfp_ps_madds0(CPUState* cpu, u8 d, u8 a, u8 c, u8 b) {
+    if (GX_FASTFP_UNLIKELY(gx_fastfp_strict(cpu))) { ppc_ps_madds0(cpu, d, a, c, b); return; }
+    const f64 t0 = gx_fastfp_madd_single(cpu->fpr[a], cpu->fpr[c], cpu->fpr[b], false);
+    const f64 t1 = gx_fastfp_madd_single(cpu->ps1[a], cpu->fpr[c], cpu->ps1[b], false);
+    if (GX_FASTFP_UNLIKELY(isnan(t0) || isnan(t1))) { ppc_ps_madds0(cpu, d, a, c, b); return; }
+    gx_fastfp_write_both(cpu, d, gx_fastfp_force_single(cpu, t0), gx_fastfp_force_single(cpu, t1));
+}
+GX_FASTFP_INLINE void gx_fastfp_ps_madds1(CPUState* cpu, u8 d, u8 a, u8 c, u8 b) {
+    if (GX_FASTFP_UNLIKELY(gx_fastfp_strict(cpu))) { ppc_ps_madds1(cpu, d, a, c, b); return; }
+    const f64 t0 = gx_fastfp_madd_single(cpu->fpr[a], cpu->ps1[c], cpu->fpr[b], false);
+    const f64 t1 = gx_fastfp_madd_single(cpu->ps1[a], cpu->ps1[c], cpu->ps1[b], false);
+    if (GX_FASTFP_UNLIKELY(isnan(t0) || isnan(t1))) { ppc_ps_madds1(cpu, d, a, c, b); return; }
+    gx_fastfp_write_both(cpu, d, gx_fastfp_force_single(cpu, t0), gx_fastfp_force_single(cpu, t1));
+}
+GX_FASTFP_INLINE void gx_fastfp_ps_muls0(CPUState* cpu, u8 d, u8 a, u8 c) {
+    if (GX_FASTFP_UNLIKELY(gx_fastfp_strict(cpu))) { ppc_ps_muls0(cpu, d, a, c); return; }
+    const f64 c0 = gx_fastfp_force_25bit_c(cpu->fpr[c]);
+    const f64 r0 = cpu->fpr[a] * c0, r1 = cpu->ps1[a] * c0;
+    if (GX_FASTFP_UNLIKELY(isnan(r0) || isnan(r1))) { ppc_ps_muls0(cpu, d, a, c); return; }
+    gx_fastfp_write_both(cpu, d, gx_fastfp_force_single(cpu, r0), gx_fastfp_force_single(cpu, r1));
+}
+GX_FASTFP_INLINE void gx_fastfp_ps_muls1(CPUState* cpu, u8 d, u8 a, u8 c) {
+    if (GX_FASTFP_UNLIKELY(gx_fastfp_strict(cpu))) { ppc_ps_muls1(cpu, d, a, c); return; }
+    const f64 c1 = gx_fastfp_force_25bit_c(cpu->ps1[c]);
+    const f64 r0 = cpu->fpr[a] * c1, r1 = cpu->ps1[a] * c1;
+    if (GX_FASTFP_UNLIKELY(isnan(r0) || isnan(r1))) { ppc_ps_muls1(cpu, d, a, c); return; }
+    gx_fastfp_write_both(cpu, d, gx_fastfp_force_single(cpu, r0), gx_fastfp_force_single(cpu, r1));
+}
+GX_FASTFP_INLINE void gx_fastfp_ps_sum0(CPUState* cpu, u8 d, u8 a, u8 c, u8 b) {
+    if (GX_FASTFP_UNLIKELY(gx_fastfp_strict(cpu))) { ppc_ps_sum0(cpu, d, a, c, b); return; }
+    const f64 r0 = cpu->fpr[a] + cpu->ps1[b];
+    if (GX_FASTFP_UNLIKELY(isnan(r0))) { ppc_ps_sum0(cpu, d, a, c, b); return; }
+    gx_fastfp_write_both(cpu, d, gx_fastfp_force_single(cpu, r0), gx_fastfp_force_single(cpu, cpu->ps1[c]));
+}
+GX_FASTFP_INLINE void gx_fastfp_ps_sum1(CPUState* cpu, u8 d, u8 a, u8 c, u8 b) {
+    if (GX_FASTFP_UNLIKELY(gx_fastfp_strict(cpu))) { ppc_ps_sum1(cpu, d, a, c, b); return; }
+    const f64 r1 = cpu->fpr[a] + cpu->ps1[b];
+    if (GX_FASTFP_UNLIKELY(isnan(r1))) { ppc_ps_sum1(cpu, d, a, c, b); return; }
+    gx_fastfp_write_both(cpu, d, gx_fastfp_force_single(cpu, cpu->fpr[c]), gx_fastfp_force_single(cpu, r1));
+}
+
+/* Redirect the generated chunk's calls. Declarations in core/cpu.h were
+ * already processed above, so only call sites in the chunk expand. */
+#define ppc_fadds(ctx, d, a, b) gx_fastfp_fadds((ctx), (d), (a), (b))
+#define ppc_fsubs(ctx, d, a, b) gx_fastfp_fsubs((ctx), (d), (a), (b))
+#define ppc_fmuls(ctx, d, a, c) gx_fastfp_fmuls((ctx), (d), (a), (c))
+#define ppc_fdivs(ctx, d, a, b) gx_fastfp_fdivs((ctx), (d), (a), (b))
+#define ppc_frsp(ctx, d, b) gx_fastfp_frsp((ctx), (d), (b))
+#define ppc_fadd(ctx, d, a, b) gx_fastfp_fadd((ctx), (d), (a), (b))
+#define ppc_fsub(ctx, d, a, b) gx_fastfp_fsub((ctx), (d), (a), (b))
+#define ppc_fmul(ctx, d, a, c) gx_fastfp_fmul((ctx), (d), (a), (c))
+#define ppc_fdiv(ctx, d, a, b) gx_fastfp_fdiv((ctx), (d), (a), (b))
+#define ppc_fma(ctx, a, c, b, single, sub, neg, out) gx_fastfp_fma((ctx), (a), (c), (b), (single), (sub), (neg), (out))
+#define ppc_ps_add_op(ctx, d, a, b) gx_fastfp_ps_add((ctx), (d), (a), (b))
+#define ppc_ps_sub_op(ctx, d, a, b) gx_fastfp_ps_sub((ctx), (d), (a), (b))
+#define ppc_ps_mul_op(ctx, d, a, c) gx_fastfp_ps_mul((ctx), (d), (a), (c))
+#define ppc_ps_div_op(ctx, d, a, b) gx_fastfp_ps_div((ctx), (d), (a), (b))
+#define ppc_ps_madd_op(ctx, d, a, c, b, sub, neg) gx_fastfp_ps_madd((ctx), (d), (a), (c), (b), (sub), (neg))
