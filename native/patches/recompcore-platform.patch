+
+bool StaticRecompCore::TryHostHle(PowerPC::PowerPCState& ppc)
+{
+  auto& memory = m_system.GetMemory();
+  const u32 ram_size = memory.GetRamSizeReal();
+  const auto word = [&](u32 address) -> u32 {
+    const u32 offset = address - 0x80000000u;
+    if (address < 0x80000000u || offset + 4 > ram_size)
+      return 0;
+    const u8* p = memory.GetRAM() + offset;
+    return (u32(p[0]) << 24) | (u32(p[1]) << 16) | (u32(p[2]) << 8) | p[3];
+  };
+  if (m_emulate_syscall_vector && ppc.pc == 0x00000C00u)
+  {
+    // The SDK's __OSSystemCallVector: HID0 toggled around a sync, then rfi.
+    // Without data-cache emulation only the rfi has an effect.
+    static constexpr u32 kStub[7] = {0x7d30faa6u, 0x612a0008u, 0x7d50fba6u, 0x4c00012cu,
+                                     0x7c0004acu, 0x7d30fba6u, 0x4c000064u};
+    for (u32 i = 0; i < 7; ++i)
+    {
+      if (word(0x80000C00u + 4 * i) != kStub[i])
+      {
+        ++m_hle_rejects;
+        return false;
+      }
+    }
+    const u32 mask = 0x87C0FFFFu;
+    ppc.msr.Hex = (ppc.msr.Hex & ~mask) | (ppc.spr[SPR_SRR1] & mask);
+    ppc.msr.Hex &= 0xFFFBFFFFu;
+    m_system.GetPowerPC().MSRUpdated();
+    ppc.pc = ppc.spr[SPR_SRR0] & ~3u;
+    ppc.npc = ppc.pc;
+    ppc.downcount -= 8;
+    ++m_hle_vectors;
+    return true;
+  }
+  for (const auto& hook : m_return_hooks)
+  {
+    if (hook.address != ppc.pc)
+      continue;
+    if (word(hook.address) != hook.first_word ||
+        word(hook.address + hook.last_word_offset) != 0x4e800020u)
+    {
+      ++m_hle_rejects;
+      return false;
+    }
+    ppc.pc = ppc.spr[SPR_LR];
+    ppc.npc = ppc.pc;
+    ppc.downcount -= 8;
+    ++m_hle_returns;
+    return true;
+  }
+  return false;
 }
 
