+  const u32 rm_ni = ppc.fpscr.Hex & 0x7u;
+  if (rm_ni != m_last_sync_fpscr_rm_ni)
+  {
+    m_last_sync_fpscr_rm_ni = rm_ni;
+    PowerPC::RoundingModeUpdated(ppc);
+  }
 }

