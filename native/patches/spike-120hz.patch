diff --git a/Source/Core/VideoCommon/CameraTrace.cpp b/Source/Core/VideoCommon/CameraTrace.cpp
new file mode 100644
index 0000000..e67ddc0
--- /dev/null
+++ b/Source/Core/VideoCommon/CameraTrace.cpp
@@ -0,0 +1,126 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// SSX 3 120 Hz spike: per-frame camera/projection trace. See CameraTrace.h.
+
+#include "VideoCommon/CameraTrace.h"
+
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <map>
+
+namespace CameraTrace
+{
+namespace
+{
+struct MatrixStats
+{
+  u32 flushes = 0;
+  u64 indices = 0;
+  std::array<float, 12> matrix{};
+};
+
+struct FrameStats
+{
+  u32 perspective_flushes = 0, ortho_flushes = 0;
+  u64 perspective_indices = 0, ortho_indices = 0;
+  std::map<std::array<float, 6>, u64> projections;  // raw projection -> indices drawn with it
+  std::map<u32, MatrixStats> matrices;               // posMatrices index -> stats
+};
+
+FrameStats s_frame;
+u64 s_frame_number = 0;
+u64 s_every = 300;
+int s_enabled = -1;
+}  // namespace
+
+bool Enabled()
+{
+  if (s_enabled < 0)
+  {
+    const char* value = std::getenv("SSX3_CAMERA_TRACE");
+    s_enabled = value && *value && std::strcmp(value, "0") != 0;
+    if (const char* every = std::getenv("SSX3_CAMERA_TRACE_EVERY"))
+      s_every = std::strtoull(every, nullptr, 10);
+    if (s_every == 0)
+      s_every = 300;
+  }
+  return s_enabled == 1;
+}
+
+void OnFlush(bool perspective, const std::array<float, 6>& raw_projection, u32 pos_matrix_index,
+             const float* pos_matrix, u32 index_count, u32 vertex_count)
+{
+  if (!Enabled())
+    return;
+  if (perspective)
+  {
+    ++s_frame.perspective_flushes;
+    s_frame.perspective_indices += index_count;
+    s_frame.projections[raw_projection] += index_count;
+    MatrixStats& stats = s_frame.matrices[pos_matrix_index];
+    ++stats.flushes;
+    stats.indices += index_count;
+    std::memcpy(stats.matrix.data(), pos_matrix, sizeof(stats.matrix));
+  }
+  else
+  {
+    ++s_frame.ortho_flushes;
+    s_frame.ortho_indices += index_count;
+  }
+  (void)vertex_count;
+}
+
+void OnPresent()
+{
+  if (!Enabled())
+    return;
+  const u64 frame = s_frame_number++;
+  if (frame % s_every == 0)
+  {
+    std::fprintf(stderr,
+                 "[ssx3-camera] frame=%llu perspective flushes=%u indices=%llu ortho flushes=%u "
+                 "indices=%llu distinct_perspective_projections=%zu\n",
+                 static_cast<unsigned long long>(frame), s_frame.perspective_flushes,
+                 static_cast<unsigned long long>(s_frame.perspective_indices),
+                 s_frame.ortho_flushes, static_cast<unsigned long long>(s_frame.ortho_indices),
+                 s_frame.projections.size());
+    for (const auto& [raw, indices] : s_frame.projections)
+    {
+      // GX perspective: raw[0]/raw[2] are the x/y focal scales, raw[4] = far/(near-far),
+      // raw[5] = near*far/(near-far). Hence near = raw[5]/raw[4], far = raw[4]*near/(raw[4]+1).
+      const float near_plane = raw[4] != 0.0f ? raw[5] / raw[4] : 0.0f;
+      const float far_plane = raw[4] != -1.0f ? raw[4] * near_plane / (raw[4] + 1.0f) : 0.0f;
+      const float fov_y = raw[2] != 0.0f ? 2.0f * std::atan(1.0f / raw[2]) * 57.29578f : 0.0f;
+      const float aspect = raw[0] != 0.0f ? raw[2] / raw[0] : 0.0f;
+      std::fprintf(stderr,
+                   "[ssx3-camera]   projection raw=[%g %g %g %g %g %g] indices=%llu near=%g far=%g "
+                   "fov_y_deg=%g aspect=%g\n",
+                   raw[0], raw[1], raw[2], raw[3], raw[4], raw[5],
+                   static_cast<unsigned long long>(indices), near_plane, far_plane, fov_y, aspect);
+    }
+    // The three position matrices that transformed the most indices this frame.
+    for (int rank = 0; rank < 3; ++rank)
+    {
+      const std::map<u32, MatrixStats>::iterator best = [&] {
+        auto it = s_frame.matrices.end();
+        for (auto cur = s_frame.matrices.begin(); cur != s_frame.matrices.end(); ++cur)
+          if (it == s_frame.matrices.end() || cur->second.indices > it->second.indices)
+            it = cur;
+        return it;
+      }();
+      if (best == s_frame.matrices.end())
+        break;
+      const auto& m = best->second.matrix;
+      std::fprintf(stderr,
+                   "[ssx3-camera]   posmatrix index=%u flushes=%u indices=%llu "
+                   "rows=[%g %g %g %g | %g %g %g %g | %g %g %g %g]\n",
+                   best->first, best->second.flushes,
+                   static_cast<unsigned long long>(best->second.indices), m[0], m[1], m[2], m[3],
+                   m[4], m[5], m[6], m[7], m[8], m[9], m[10], m[11]);
+      s_frame.matrices.erase(best);
+    }
+  }
+  s_frame = FrameStats{};
+}
+}  // namespace CameraTrace
