@@ -0,0 +1,24 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// SSX 3 120 Hz spike: per-frame camera/projection trace (SSX3_CAMERA_TRACE=1).
+//
+// Records, per presented frame, the perspective projections seen by VertexManagerBase::Flush
+// and the position matrix (GX posMatrices index) that transformed the most indices. This is
+// the input a depth-reprojection or MetalFX frame interpolator would need: near/far planes,
+// vertical field of view, and a dominant view matrix. Output goes to stderr every
+// SSX3_CAMERA_TRACE_EVERY frames (default 300).
+
+#pragma once
+
+#include <array>
+
+#include "Common/CommonTypes.h"
+
+namespace CameraTrace
+{
+bool Enabled();
+// Called from VertexManagerBase::Flush for triangle draws.
+void OnFlush(bool perspective, const std::array<float, 6>& raw_projection, u32 pos_matrix_index,
+             const float* pos_matrix, u32 index_count, u32 vertex_count);
+// Called once per presented frame (Presenter::Present).
+void OnPresent();
+}  // namespace CameraTrace
