@@ -64,6 +195,7 @@ void vu0ExecMicro(u32 addr) {
 	VU0.cycle = cpuRegs.cycle;
 	if ((s32)addr != -1) VU0.VI[REG_TPC].UL = addr & 0x1FF;
 
