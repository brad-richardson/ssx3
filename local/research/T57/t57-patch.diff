diff --git a/pcsx2/VU0micro.cpp b/pcsx2/VU0micro.cpp
index 1e2081d4c..2b94b0d71 100644
--- a/pcsx2/VU0micro.cpp
+++ b/pcsx2/VU0micro.cpp
@@ -9,6 +9,136 @@
 
 #include <cmath>
 
+// T57: VU0 micro-program start/end watch + VIF0 command census (log-only).
+#include <atomic>
+extern std::atomic<int> g_t48_vsync; // T57: defined in GS.cpp (T48 vsync mirror).
+#define T57_MAXL 2000
+static u32 g_t57_n = 0;
+static bool g_t57_capped = false;
+static bool t57_budget()
+{
+	if (g_t57_n >= T57_MAXL)
+	{
+		if (!g_t57_capped) { g_t57_capped = true; Console.WriteLn("T57_CAP vsync=%d", g_t48_vsync.load(std::memory_order_relaxed)); }
+		return false;
+	}
+	g_t57_n++;
+	return true;
+}
+static const char* t57_opname(u32 cmd) // T57: VIF code names (same table as T49 t49_vif_name).
+{
+	switch (cmd)
+	{
+		case 0x00: return "NOP";
+		case 0x01: return "STCYCL";
+		case 0x02: return "OFFSET";
+		case 0x03: return "BASE";
+		case 0x04: return "ITOP";
+		case 0x05: return "STMOD";
+		case 0x06: return "MSKPATH3";
+		case 0x07: return "MARK";
+		case 0x10: return "FLUSHE";
+		case 0x11: return "FLUSH";
+		case 0x13: return "FLUSHA";
+		case 0x14: return "MSCAL";
+		case 0x15: return "MSCALF";
+		case 0x17: return "MSCNT";
+		case 0x20: return "STMASK";
+		case 0x30: return "STROW";
+		case 0x31: return "STCOL";
+		case 0x4a: return "MPG";
+		case 0x50: return "DIRECT";
+		case 0x51: return "DIRECTHL";
+		default: break;
+	}
+	if (cmd >= 0x60 && cmd <= 0x7f) return "UNPACK";
+	return "NULL";
+}
+static const char* t57_vianame(u32 v)
+{
+	return v == 0 ? "cop2" : (v == 1 ? "vif0" : "unknown");
+}
+static bool g_t57_pend = false;
+static u32 g_t57_pcaller = 0, g_t57_pvia = 9, g_t57_pstart = 0, g_t57_pms = 0;
+static u64 g_t57_pc0 = 0;
+static u32 g_t57_ctx_via = 9, g_t57_ctx_caller = 0, g_t57_ctx_ms = 0;
+static u32 g_t57_noebit = 0; // T57: E-bit stops with nothing pending (pre-window program).
+void t57_cop2_ctx() { g_t57_ctx_via = 0; g_t57_ctx_caller = cpuRegs.pc; g_t57_ctx_ms = 0; }
+void t57_vif0_ctx() { g_t57_ctx_via = 1; g_t57_ctx_caller = cpuRegs.pc; }
+void t57_msop(u32 op) { g_t57_ctx_ms = op; }
+static u32 g_t57c[128] = {0,};
+static int g_t57c_vs = -1;
+static void t57_vif0_flush(int vs)
+{
+	for (u32 c = 0; c < 128; c++)
+	{
+		if (!g_t57c[c]) continue;
+		if (!t57_budget()) return;
+		Console.WriteLn("vif0op vsync=%d op=%s n=%u", vs, t57_opname(c), g_t57c[c]);
+	}
+}
+static void t57_vif0_sync()
+{
+	if (g_t57c_vs < 0) return;
+	int v = g_t48_vsync.load(std::memory_order_relaxed);
+	if (v == g_t57c_vs) return;
+	t57_vif0_flush(g_t57c_vs);
+	for (u32 c = 0; c < 128; c++) g_t57c[c] = 0;
+	g_t57c_vs = v;
+}
+void t57_vif0_count(u32 cmd)
+{
+	int v = g_t48_vsync.load(std::memory_order_relaxed);
+	if (g_t57c_vs < 0) g_t57c_vs = v;
+	if (v != g_t57c_vs) { t57_vif0_flush(g_t57c_vs); for (u32 c = 0; c < 128; c++) g_t57c[c] = 0; g_t57c_vs = v; }
+	if (cmd < 128) g_t57c[cmd]++;
+}
+static void t57_emit(bool abort)
+{
+	if (!t57_budget()) return;
+	t57_vif0_sync(); // T57: flush any stale census vsync before the vu0call line.
+	int vs = g_t48_vsync.load(std::memory_order_relaxed);
+	u32 vi1 = VU0.VI[1].UL, vi2 = VU0.VI[2].UL;
+	unsigned long long cyc = (unsigned long long)(VU0.cycle - g_t57_pc0);
+	const char* via = t57_vianame(g_t57_pvia);
+	bool mark = (g_t57_pvia == 0 && g_t57_pcaller == 0x37deb8);
+	const char* ab = abort ? " end=abort" : "";
+	if (g_t57_pvia == 1)
+		Console.WriteLn("vu0call vsync=%d caller_pc=0x%x via=%s startPC=0x%x cycles=%llu vi1=0x%x vi2=0x%x ms=0x%x%s", vs, g_t57_pcaller, via, g_t57_pstart, cyc, vi1, vi2, g_t57_pms, ab);
+	else if (mark)
+		Console.WriteLn("vu0call vsync=%d caller_pc=0x%x via=%s startPC=0x%x cycles=%llu vi1=0x%x vi2=0x%x mark=sub_0037D968%s", vs, g_t57_pcaller, via, g_t57_pstart, cyc, vi1, vi2, ab);
+	else
+		Console.WriteLn("vu0call vsync=%d caller_pc=0x%x via=%s startPC=0x%x cycles=%llu vi1=0x%x vi2=0x%x%s", vs, g_t57_pcaller, via, g_t57_pstart, cyc, vi1, vi2, ab);
+}
+void t57_entry() // T57: top of vu0ExecMicro - previous program died without E-bit.
+{
+	if (g_t57_pend && !(VU0.VI[REG_VPU_STAT].UL & 1))
+	{
+		t57_emit(true);
+		g_t57_pend = false;
+	}
+}
+void t57_arm() // T57: after the stall-finish, before the new setup clobbers TPC.
+{
+	if (g_t57_pend)
+	{
+		t57_emit(true); // T57: superseded without E-bit (e.g. M-bit-stuck).
+		g_t57_pend = false;
+	}
+	g_t57_pcaller = g_t57_ctx_caller; g_t57_pvia = g_t57_ctx_via; g_t57_pms = g_t57_ctx_ms;
+	g_t57_pstart = (VU0.VI[REG_TPC].UL << 3);
+	g_t57_pc0 = VU0.cycle;
+	g_t57_pend = true;
+	g_t57_ctx_via = 9; g_t57_ctx_caller = 0; g_t57_ctx_ms = 0;
+}
+void t57_vu0_ebit() // T57: E-bit stop in _vu0Exec (VU0 interp only).
+{
+	if (!g_t57_pend) { g_t57_noebit++; return; }
+	t57_emit(false);
+	g_t57_pend = false;
+}
+
+
 using namespace R5900;
 
