+        }
+        for (int a = GAMEPAD_AXIS_LEFT_X; a <= GAMEPAD_AXIS_RIGHT_Y && !s_used; ++a)
+        {
+            s_used = std::fabs(GetGamepadAxisMovement(i, a)) > 0.5f;
+        }
+    }
+    if (!any)
