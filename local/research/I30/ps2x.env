# I26 (from I25) bundled defaults (copied into the .app as ps2x.env).
# A ps2x.env in the app's Documents folder (Files app > On My iPhone >
# SSX3 PS2X) overrides any key here; devicectl launch -e overrides both.
# ${BUNDLE} = the .app folder, ${DOCUMENTS} = the app's Documents folder.
PS2X_BOOT_ELF=${BUNDLE}/SLUS_207.72
PS2X_CD_IMAGE=${BUNDLE}/SSX3.iso
PS2X_MC_ROOT=${DOCUMENTS}/mc0
# Dev-only startup-movie bypass (approved, default off elsewhere).
PS2X_SKIP_MOVIE=1
PS2X_DEINTERLACE=weave
# Check-in mode: I26 fast route (named I26-FAST in local/research/I26/ROUTES.md),
# title -> Select Character -> Happiness race in ~19 guest s from the title
# prompt (E33's route took ~109). Off: iOS Settings > SSX3 PS2X > Auto-route,
# or PS2X_PAD_SCRIPT= (empty) in Documents/ps2x.env.
PS2X_PAD_SCRIPT_CLOCK=vsync
PS2X_PAD_SCRIPT=10611:start:250,12780:cross:250,14749:cross:250,16567:cross:250,18336:cross:250,19770:cross:250,21205:down:150,21706:down:150,22306:cross:250,24025:cross:250,28512:cross:200,28763:down:700,29513:cross:200,29764:down:700,30514:cross:200,30765:down:700,31515:cross:200,31766:down:700,32516:cross:200,32767:down:700,33517:cross:200,33768:down:700,34518:cross:200,34769:down:700,35519:cross:200,35770:down:700,36520:cross:200,36771:down:700,37521:cross:200,37772:down:700,38522:down:30000
# No PS2X_FRAME_DUMP_DIR: PNG dumps stay off (a diagnostic cost).
# I30: sound on by default so Brad can listen (AU8 planar music fix at f2ec588).
PS2X_SOUND=1
