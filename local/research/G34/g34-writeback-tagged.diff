diff --git a/gs/gs_interface.cpp b/gs/gs_interface.cpp
index ea00016..a5eaa8f 100644
--- a/gs/gs_interface.cpp
+++ b/gs/gs_interface.cpp
@@ -4684,2 +4723,57 @@ ScanoutResult GSInterface::vsync(const VSyncInfo &info_)
 
+	{
+		// G34 local diagnostic (not upstream): H1-vs-H2 TAGGED write-back.
+		// Same W1 shape as G33 (map-read region B, pages 112..223, into
+		// a static temp, map-write back + commit BEFORE this vsync's
+		// sample), but OR-masks a sparse nonzero-RGB tag into the temp
+		// pre-commit: word 0 of each of the 112 pages |= 0x00FFFFFF.
+		// Write leg is call-identical to G32/G33 (same base/n/rect/site).
+		// H1 (ordering/coherency) predicts the tag renders EXACTLY
+		// (ladder 86ad7b887e140383, 112 white pixels); H2
+		// (content-dependent fault) predicts cleared (tag is not the
+		// G32 pattern). The receipt checksums the TAGGED temp (proving
+		// what was re-written); G31-B verifies the tagged source.
+		const size_t g34_base = 112 * 8192;
+		const size_t g34_n = 112 * 8192;
+		static uint32_t g34_temp[(112 * 8192) / 4];
+		const uint32_t *g34_src = static_cast<const uint32_t *>(map_vram_read(g34_base, g34_n));
+		if (g34_src)
+		{
+			for (size_t g34_i = 0; g34_i < g34_n / 4; g34_i++)
+			{
+				g34_temp[g34_i] = g34_src[g34_i];
+			}
+			for (size_t g34_p = 0; g34_p < 112; g34_p++)
+			{
+				g34_temp[g34_p * 2048] |= 0x00ffffffu;
+			}
+			uint64_t g34_f = 1469598103934665603ull;
+			size_t g34_z = 0;
+			const uint8_t *g34_tb = reinterpret_cast<const uint8_t *>(g34_temp);
+			for (size_t g34_i = 0; g34_i < g34_n; g34_i++)
+			{
+				g34_f ^= g34_tb[g34_i];
+				g34_f *= 1099511628211ull;
+				g34_z += g34_tb[g34_i] != 0;
+			}
+			uint32_t *g34_dst = static_cast<uint32_t *>(map_vram_write(g34_base, g34_n));
+			if (g34_dst)
+			{
+				for (size_t g34_i = 0; g34_i < g34_n / 4; g34_i++)
+				{
+					g34_dst[g34_i] = g34_temp[g34_i];
+				}
+				end_vram_write(g34_base, g34_n);
+				LOGI("G34: writeback base=%u n=%u fnv=%016llx nz=%u.\n", (unsigned)g34_base, (unsigned)g34_n, (unsigned long long)g34_f, (unsigned)g34_z);
+			}
+			else
+			{
+				LOGI("G34: writeback write-map failed.\n");
+			}
+		}
+		else
+		{
+			LOGI("G34: writeback read-map failed.\n");
+		}
+	}
 	auto result = renderer.vsync(priv_registers, info,
