+	if (!t53w_arm()) return;
+	u32 pbase = vaddr & 0x0fffffff; // T53: fold mirrors (E41); T51's 0x1fffffff missed 0x2/0x3 mirrors.
+	u32 lo = pbase;
+	u32 hi = pbase + size;
+	int t53_vs = g_t48_vsync.load(std::memory_order_relaxed);
+	for (u32 i = 0; i < g_t53w_naddr; i++)
+	{
+		u32 w = g_t53w_addr[i];
+		if (w + 4 <= lo || w >= hi) continue;
+		u32 k = g_t53w_hits[i]++;
+		if (k >= 64)
+		{
+			if (k == 64) Console.WriteLn("T53W_CAP vsync=%d addr=0x%x", t53_vs, w);
+			continue;
+		}
+		Console.WriteLn("tagaddrwrite vsync=%d addr=0x%x value=0x%x pc=0x%x ra=0x%x a0=%08x a1=%08x a2=%08x a3=%08x v0=%08x v1=%08x t0=%08x t1=%08x t2=%08x t3=%08x t4=%08x t5=%08x t6=%08x t7=%08x t8=%08x t9=%08x s0=%08x s1=%08x s2=%08x s3=%08x s4=%08x s5=%08x s6=%08x s7=%08x tu=swc1",
