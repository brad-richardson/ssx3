+// T53: folded-mirror ADDR-word write watch (log-only; addresses from /tmp/t53-watch).
+#define T53W_MAXA 16
+static u32 g_t53w_addr[T53W_MAXA];
+static u32 g_t53w_naddr = 0;
+static u32 g_t53w_hits[T53W_MAXA];
+static bool g_t53w_armed = false;
+static u32 g_t53w_arm_ctr = 0;
+static bool t53w_arm()
+{
+	if (g_t53w_armed) return true;
+	if ((++g_t53w_arm_ctr & 1023) != 0) return false; // EE interp thread only.
+	FILE* t53wf = fopen("/tmp/t53-watch", "r");
+	if (!t53wf) return false;
+	char t53line[64];
+	while (g_t53w_naddr < T53W_MAXA && fgets(t53line, sizeof(t53line), t53wf))
+	{
+		u32 a = (u32)strtoul(t53line, nullptr, 0);
+		if (a == 0) continue;
+		g_t53w_addr[g_t53w_naddr] = (a & 0x0fffffff) & ~3u; // T53: fold 0x00/0x20/0x30/0x80 mirrors (E41).
+		g_t53w_hits[g_t53w_naddr] = 0;
+		g_t53w_naddr++;
+	}
+	fclose(t53wf);
+	g_t53w_armed = true;
+	Console.WriteLn("T53W_ARMED naddr=%u", g_t53w_naddr);
+	return true;
+}
+// EE store overlapping a watched ADDR word (post-write word + 28 GPRs, first 64 per address per TU).
+static void t53w_watch(u32 vaddr, u32 size)
