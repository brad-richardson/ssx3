diff --git a/gs/gs_interface.cpp b/gs/gs_interface.cpp
index ea00016..fff1437 100644
--- a/gs/gs_interface.cpp
+++ b/gs/gs_interface.cpp
@@ -4684,2 +4723,58 @@ ScanoutResult GSInterface::vsync(const VSyncInfo &info_)
 
+	{
+		// G37 local diagnostic (not upstream): minimum-content threshold wall.
+		// Same legs as G36 (map-read region B, pages 112..223, into a static
+		// temp; write leg via RAW renderer.begin_host_vram_access() + CPU copy
+		// with NEITHER map_vram_write NOR end_vram_write -- no flush, no wait,
+		// no commit: no get_host_write_timeline, no flush_submit, no wait_timeline,
+		// no end_host_write_vram_access, no commit), but the tag is SHRUNKEN to
+		// ONE word: word 0 of page 112 ONLY (temp[0] |= 0x00FFFFFF; stale word
+		// is 0x00000000 so the tag word is 0x00FFFFFF -- RGB white, alpha 0x00).
+		// The mapping is never closed (reads are never closed anywhere in this
+		// lane either); begins/vsync unchanged vs G36 (read + raw + G31).
+		// Receipt checksums the SHRUNKEN temp (host-side, barrier-independent);
+		// G31-B + G30 vpage witness the read leg. ANY-nonzero-RGB predicts
+		// 1-pixel-exact (debe0cda9c919bde, white at (0,0)); higher-threshold
+		// models predict cleared (aa2fa32572450383). G36's committed block is
+		// excised by this same edit (lossless).
+		const size_t g37_base = 112 * 8192;
+		const size_t g37_n = 112 * 8192;
+		static uint32_t g37_temp[(112 * 8192) / 4];
+		const uint32_t *g37_src = static_cast<const uint32_t *>(map_vram_read(g37_base, g37_n));
+		if (g37_src)
+		{
+			for (size_t g37_i = 0; g37_i < g37_n / 4; g37_i++)
+			{
+				g37_temp[g37_i] = g37_src[g37_i];
+			}
+			g37_temp[0] |= 0x00ffffffu;
+			uint64_t g37_f = 1469598103934665603ull;
+			size_t g37_z = 0;
+			const uint8_t *g37_tb = reinterpret_cast<const uint8_t *>(g37_temp);
+			for (size_t g37_i = 0; g37_i < g37_n; g37_i++)
+			{
+				g37_f ^= g37_tb[g37_i];
+				g37_f *= 1099511628211ull;
+				g37_z += g37_tb[g37_i] != 0;
+			}
+			void *g37_raw = renderer.begin_host_vram_access();
+			if (g37_raw)
+			{
+				uint32_t *g37_dst = reinterpret_cast<uint32_t *>(static_cast<uint8_t *>(g37_raw) + g37_base);
+				for (size_t g37_i = 0; g37_i < g37_n / 4; g37_i++)
+				{
+					g37_dst[g37_i] = g37_temp[g37_i];
+				}
+				LOGI("G37: writeback base=%u n=%u fnv=%016llx nz=%u.\n", (unsigned)g37_base, (unsigned)g37_n, (unsigned long long)g37_f, (unsigned)g37_z);
+			}
+			else
+			{
+				LOGI("G37: writeback raw-map failed.\n");
+			}
+		}
+		else
+		{
+			LOGI("G37: writeback read-map failed.\n");
+		}
+	}
 	auto result = renderer.vsync(priv_registers, info,
