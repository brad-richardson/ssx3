+// NOTE(d8-spin): SSX3_THROTTLE_SPIN=1 busy-waits instead of sleeping when
+// the throttle remainder is under 4 ms, keeping the emulation thread
+// scheduled so the governor does not park it at its floor under a cap.
+static bool Ssx3ThrottleSpinEnabled()
+{
+  static const bool enabled = [] {
+    const char* value = std::getenv("SSX3_THROTTLE_SPIN");
+    return value != nullptr && std::string(value) == "1";
+  }();
+  return enabled;
+}
+
 void CoreTimingManager::SleepUntil(TimePoint time_point)
 {
+  if (Ssx3ThrottleSpinEnabled())
+  {
+    const TimePoint now = Clock::now();
+    if (time_point > now && (time_point - now) < std::chrono::milliseconds(4))
+    {
+      while (Clock::now() < time_point)
+      {
+#if defined(__ANDROID__) || defined(__linux__)
+        ::sched_yield();
+#else
+        std::this_thread::yield();
+#endif
+      }
+      // Same analytics as the sleep path below.
+      if (Core::IsCPUThread())
+      {
+        const TimePoint time_after_spin = Clock::now();
+        m_system.GetPerfMetrics().CountThrottleSleep(time_after_spin - now);
+      }
+      return;
+    }
+  }
