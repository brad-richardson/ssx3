+// D5 TEMPORARY exception attribution (never committed; see D5/instrument.patch).
+namespace D5Exc
+{
+struct Slot
+{
+  u64 count = 0;
+  u64 ns_total = 0;
+  u64 timed = 0;
+  u64 nested = 0;
+};
+// Fixed array indexed by vector>>8: classic vectors land at 0x3..0xF while
+// 0x8000xxxx aliases keep their identity up at 0x8000x.
+constexpr u32 kSlots = 0x80010u;
+Slot g_slots[kSlots];
+u64 g_slot_overflow = 0;
+std::unordered_map<u32, u64> g_pc800;  // faulting srr0, vector 0x800 only
+struct OpenExc
+{
+  bool active = false;
+  u32 slot = 0;
+  u32 fault = 0;
+  u64 t0 = 0;
+};
+OpenExc g_open;
+
+inline u64 NowNs()
+{
+  timespec ts{};
+  clock_gettime(CLOCK_MONOTONIC, &ts);
+  return static_cast<u64>(ts.tv_sec) * 1000000000ull + static_cast<u64>(ts.tv_nsec);
+}
+
+// Top of each dispatch iteration, pre-dispatch guest pc.
+inline void OnDispatchPc(u32 pc)
+{
+  if (!g_open.active || pc != g_open.fault)
+    return;
+  g_open.active = false;
+  Slot& s = g_slots[g_open.slot];
+  s.ns_total += NowNs() - g_open.t0;
+  ++s.timed;
+}
+
+// At the ++m_native_exceptions site: vec is the vector, fault the srr0.
+inline void OnRaise(u32 vec, u32 fault)
+{
+  const u32 slot = vec >> 8;
+  if (slot >= kSlots)
+  {
+    ++g_slot_overflow;
+    return;
+  }
+  if (g_open.active)
+    ++g_slots[g_open.slot].nested;  // superseded before its rfi return
+  g_open.active = true;
+  g_open.slot = slot;
+  g_open.fault = fault;
+  g_open.t0 = NowNs();
+  ++g_slots[slot].count;
+  if (vec == 0x800u)
+    ++g_pc800[fault];
 }
+}  // namespace D5Exc
 
