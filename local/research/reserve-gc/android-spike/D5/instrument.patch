+// D5 TEMPORARY exception attribution dump (never committed).
+void StaticRecompCore::DumpExcAttribution()
+{
+  for (u32 i = 0; i < D5Exc::kSlots; ++i)
+  {
+    const D5Exc::Slot& s = D5Exc::g_slots[i];
+    if (s.count == 0 && s.nested == 0)
+      continue;
+    const u64 mean = s.timed ? s.ns_total / s.timed : 0;
+    std::fprintf(stderr, "exc vector=0x%x count=%llu ns_total=%llu ns_mean=%llu nested=%llu\n",
+                 i << 8, static_cast<unsigned long long>(s.count),
+                 static_cast<unsigned long long>(s.ns_total),
+                 static_cast<unsigned long long>(mean),
+                 static_cast<unsigned long long>(s.nested));
+  }
+  if (D5Exc::g_slot_overflow)
+  {
+    std::fprintf(stderr, "exc vector=OVERFLOW count=%llu\n",
+                 static_cast<unsigned long long>(D5Exc::g_slot_overflow));
+  }
+  std::vector<std::pair<u32, u64>> pcs(D5Exc::g_pc800.begin(), D5Exc::g_pc800.end());
+  std::sort(pcs.begin(), pcs.end(),
+            [](const auto& l, const auto& r) { return l.second > r.second; });
+  for (std::size_t i = 0; i < pcs.size() && i < 32; ++i)
+  {
+    std::fprintf(stderr, "exc_pc vector=0x800 pc=0x%08x count=%llu\n", pcs[i].first,
+                 static_cast<unsigned long long>(pcs[i].second));
+  }
+}
