@@ -241,14 +241,70 @@ int main(int argc, char **argv)
 	uint64_t start_ns = 0;
 	unsigned vsyncs = 0;
 
+	// G45 proof overlay (uncommitted): P1 readback + PPM emission, byte-same
+	// save path as G8, last-pass collection as G10, nothing else.
+	auto g45_save_ppm = [&](ScanoutResult shot, const std::string &ppm_path, const char *tag) {
+		if (!shot.image)
+		{
+			LOGE("G45: no image in %s vsync result.\n", tag);
+			return;
+		}
+		BufferHandle shot_readback;
+		{
+			auto cmd = device.request_command_buffer();
+			cmd->image_barrier(*shot.image, VK_IMAGE_LAYOUT_READ_ONLY_OPTIMAL,
+			                   VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+			                   VK_PIPELINE_STAGE_2_FRAGMENT_SHADER_BIT, 0,
+			                   VK_PIPELINE_STAGE_2_COPY_BIT, VK_ACCESS_2_TRANSFER_READ_BIT);
+
+			BufferCreateInfo shot_bufinfo = {};
+			shot_bufinfo.size = shot.image->get_width() * shot.image->get_height() * sizeof(uint32_t);
+			shot_bufinfo.usage = VK_BUFFER_USAGE_TRANSFER_DST_BIT;
+			shot_bufinfo.domain = BufferDomain::CachedHost;
+			shot_readback = device.create_buffer(shot_bufinfo);
+			cmd->copy_image_to_buffer(*shot_readback, *shot.image, 0, {},
+			                          { shot.image->get_width(), shot.image->get_height(), 1 },
+			                          0, 0, { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 });
+			cmd->barrier(VK_PIPELINE_STAGE_2_COPY_BIT, VK_ACCESS_2_TRANSFER_WRITE_BIT,
+			             VK_PIPELINE_STAGE_2_HOST_BIT, VK_ACCESS_2_HOST_READ_BIT);
+			device.submit(cmd);
+			device.wait_idle();
+		}
+
+		auto *shot_pixels = static_cast<const uint8_t *>(
+				device.map_host_buffer(*shot_readback, MEMORY_ACCESS_READ_BIT));
+
+		unsigned shot_w = shot.image->get_width(), shot_h = shot.image->get_height();
+		FILE *ppm = fopen(ppm_path.c_str(), "wb");
+		if (ppm)
+		{
+			fprintf(ppm, "P6\n%u %u\n255\n", shot_w, shot_h);
+			for (unsigned i = 0; i < shot_w * shot_h; i++)
+				fwrite(shot_pixels + i * 4, 1, 3, ppm);
+			fclose(ppm);
+		}
+		else
+		{
+			LOGE("G45: failed to write %s.\n", ppm_path.c_str());
+		}
+	};
+	std::vector<ScanoutResult> g45_series;
+	g45_series.reserve(16);
+
 	do
 	{
-		do
+		bool g45_last_pass = (iterations == total_iterations - 1);
+		for (;;)
 		{
 			LOGI("Running frame ...\n");
 			if (iterations > 0)
 				vsyncs++;
-		} while (parser.iterate_until_vsync(high_res_scanout, conservative_crtc));
+			bool g45_more = parser.iterate_until_vsync(high_res_scanout, conservative_crtc);
+			if (!g45_more)
+				break;
+			if (g45_last_pass)
+				g45_series.push_back(parser.consume_vsync_result());
+		}
 
 		if (!parser.restart())
 		{
@@ -275,6 +331,21 @@ int main(int argc, char **argv)
 	double total_time = double(end_ns - start_ns) * 1e-9;
 	LOGI("Total time per VBlank: %.3f ms\n", 1e3 * total_time / double(vsyncs));
 
+	// G45 proof overlay (uncommitted): emit last-pass series after end_ns.
+	if (!g45_series.empty())
+	{
+		for (size_t g45_i = 0; g45_i < g45_series.size(); g45_i++)
+		{
+			char g45_tag[32];
+			snprintf(g45_tag, sizeof(g45_tag), "vsync%zu", g45_i);
+			g45_save_ppm(g45_series[g45_i], dump_path + ".g10-" + g45_tag + ".ppm", g45_tag);
+		}
+		g45_save_ppm(g45_series.front(), dump_path + ".g8-first.ppm", "first");
+		g45_save_ppm(g45_series.back(), dump_path + ".g8-last.ppm", "last");
+	}
+	else
+		LOGE("G45: no iterate-true on the last pass; no scanout series.\n");
+
 	LOGI("Done!\n");
 
