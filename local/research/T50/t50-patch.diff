+	else if (mem == 0x10009010) rn = "D1_MADR";
+	else if (mem == 0x10009020) rn = "D1_QWC";
+	else if (mem == 0x10009030) rn = "D1_TADR";
+	else return;
+	if (!t50b_gate()) return;
+	if (g_t50b_dm_n >= 256)
+	{
+		if (!g_t50b_dm_capped)
