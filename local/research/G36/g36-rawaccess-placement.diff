diff --git a/gs/gs_interface.cpp b/gs/gs_interface.cpp
index ea00016..710ce6a 100644
--- a/gs/gs_interface.cpp
+++ b/gs/gs_interface.cpp
@@ -4684,2 +4723,61 @@ ScanoutResult GSInterface::vsync(const VSyncInfo &info_)
 
+	{
+		// G36 local diagnostic (not upstream): barrier-vs-content wall.
+		// Same read leg as G35 (map-read region B, pages 112..223, into
+		// a static temp, same sparse tag OR-masked pre-write: word 0 of
+		// each of the 112 pages |= 0x00FFFFFF), but the write leg places
+		// the tagged temp via RAW renderer.begin_host_vram_access() + CPU
+		// copy with NEITHER map_vram_write NOR end_vram_write -- no flush,
+		// no wait, no commit (no get_host_write_timeline, no flush_submit,
+		// no wait_timeline, no end_host_write_vram_access, no commit).
+		// The mapping is never closed (reads are never closed anywhere
+		// in this lane either); begins/vsync unchanged vs G35 (read +
+		// raw + G31). Receipt checksums the TAGGED temp (host-side,
+		// barrier-independent); G31-B + G30 vpage witness the read leg.
+		// Pure-refined-H2 predicts tag-visible (86ad7b887e140383, 112
+		// whites); H1-as-barrier predicts cleared (aa2fa32572450383).
+		// G35's committed block is excised by this same edit (lossless).
+		const size_t g36_base = 112 * 8192;
+		const size_t g36_n = 112 * 8192;
+		static uint32_t g36_temp[(112 * 8192) / 4];
+		const uint32_t *g36_src = static_cast<const uint32_t *>(map_vram_read(g36_base, g36_n));
+		if (g36_src)
+		{
+			for (size_t g36_i = 0; g36_i < g36_n / 4; g36_i++)
+			{
+				g36_temp[g36_i] = g36_src[g36_i];
+			}
+			for (size_t g36_p = 0; g36_p < 112; g36_p++)
+			{
+				g36_temp[g36_p * 2048] |= 0x00ffffffu;
+			}
+			uint64_t g36_f = 1469598103934665603ull;
+			size_t g36_z = 0;
+			const uint8_t *g36_tb = reinterpret_cast<const uint8_t *>(g36_temp);
+			for (size_t g36_i = 0; g36_i < g36_n; g36_i++)
+			{
+				g36_f ^= g36_tb[g36_i];
+				g36_f *= 1099511628211ull;
+				g36_z += g36_tb[g36_i] != 0;
+			}
+			void *g36_raw = renderer.begin_host_vram_access();
+			if (g36_raw)
+			{
+				uint32_t *g36_dst = reinterpret_cast<uint32_t *>(static_cast<uint8_t *>(g36_raw) + g36_base);
+				for (size_t g36_i = 0; g36_i < g36_n / 4; g36_i++)
+				{
+					g36_dst[g36_i] = g36_temp[g36_i];
+				}
+				LOGI("G36: writeback base=%u n=%u fnv=%016llx nz=%u.\n", (unsigned)g36_base, (unsigned)g36_n, (unsigned long long)g36_f, (unsigned)g36_z);
+			}
+			else
+			{
+				LOGI("G36: writeback raw-map failed.\n");
+			}
+		}
+		else
+		{
+			LOGI("G36: writeback read-map failed.\n");
+		}
+	}
 	auto result = renderer.vsync(priv_registers, info,
