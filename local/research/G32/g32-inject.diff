diff --git a/gs/gs_interface.cpp b/gs/gs_interface.cpp
--- a/gs/gs_interface.cpp
+++ b/gs/gs_interface.cpp
@@ -4684,2 +4723,32 @@ ScanoutResult GSInterface::vsync(const VSyncInfo &info_)
 
+	{
+		// G32 local diagnostic (not upstream): sample_quad[0] unit probe.
+		// Writes a controlled two-zone pattern into the DISPFB1 window
+		// (region B, pages 112..223) BEFORE this vsync's sample, so every
+		// circuit1 sample reads known bytes: zone E (pages 112..167)
+		// address-echo words 0xE1<24-bit byte addr>, zone C (pages
+		// 168..223) constant 0xE1ABCDEF. Every pattern word has nonzero
+		// RGB, so uniform cleared output is impossible under correct
+		// sampling. Tracker-aware write (flush+wait via map, commit via
+		// end), same class as the G29/G30/G31 read path. Verified
+		// post-sample by the retained G31 bytes line (B must equal the
+		// pattern FNV dfe2b6516a519f83).
+		const size_t g32_base = 112 * 8192;
+		const size_t g32_n = 112 * 8192;
+		uint32_t *g32_vram = static_cast<uint32_t *>(map_vram_write(g32_base, g32_n));
+		if (g32_vram)
+		{
+			for (size_t g32_i = 0; g32_i < g32_n / 4; g32_i++)
+			{
+				uint32_t g32_addr = (uint32_t)(g32_base + g32_i * 4);
+				g32_vram[g32_i] = g32_addr < 168 * 8192 ? (0xe1000000u | (g32_addr & 0x00ffffffu)) : 0xe1abcdefu;
+			}
+			end_vram_write(g32_base, g32_n);
+			LOGI("G32: inject base=%u n=%u.\n", (unsigned)g32_base, (unsigned)g32_n);
+		}
+		else
+		{
+			LOGI("G32: inject map failed.\n");
+		}
+	}
 	auto result = renderer.vsync(priv_registers, info,
