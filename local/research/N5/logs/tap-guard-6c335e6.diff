commit 6c335e604b4182cafc3d8505409abbd4f4864bdc
Author: n2-local <n2@local>
Date:   Wed Sep 23 19:45:56 2026 -0400

    [N5-local] PS2X_ENABLE_DIAG_TAPS: compile the E40-E44 guest-memory watch taps out of the READ/WRITE macros (n5-android only; candidate for fork ssx3)
    
    ps2_runtime_macros.h calls the taps through namespace aliases
    (ps2x_tap_mpg/e41/e43/e44). With PS2X_ENABLE_DIAG_TAPS=1 they alias the
    real trace namespaces (behavior unchanged). With =0 they are constexpr-false
    predicates, empty note functions and no-op scoped guards, so each tap and
    its argument setup compile to nothing in every generated function. The
    trace headers are only included when ON.
    
    CMake option PS2X_ENABLE_DIAG_TAPS, default ON off-Android and OFF on
    Android, as a PUBLIC define on ps2_runtime (reaches ps2_game_objects).
    Stubs/GS.cpp and Stubs/Pad.cpp now include ps2_e44_trace.h directly
    (they relied on the macros header for it).
    
    Orchestrated-By: Claude Code

diff --git a/ps2xRuntime/CMakeLists.txt b/ps2xRuntime/CMakeLists.txt
index 61a0e09..3b7b8c3 100644
--- a/ps2xRuntime/CMakeLists.txt
+++ b/ps2xRuntime/CMakeLists.txt
@@ -464,6 +464,20 @@ if(PS2X_ENABLE_RUNTIME_LOGS)
     )
 endif()
 
+# N5: E40-E44 guest-memory watch taps in ps2_runtime_macros.h. OFF compiles
+# them out of every generated function (speed builds); desktop dev keeps them.
+if(ANDROID)
+    set(PS2X_ENABLE_DIAG_TAPS_DEFAULT OFF)
+else()
+    set(PS2X_ENABLE_DIAG_TAPS_DEFAULT ON)
+endif()
+option(PS2X_ENABLE_DIAG_TAPS "Compile the E40-E44 guest-memory watch taps into the READ/WRITE macros" ${PS2X_ENABLE_DIAG_TAPS_DEFAULT})
+if(PS2X_ENABLE_DIAG_TAPS)
+    target_compile_definitions(ps2_runtime PUBLIC PS2X_ENABLE_DIAG_TAPS=1)
+else()
+    target_compile_definitions(ps2_runtime PUBLIC PS2X_ENABLE_DIAG_TAPS=0)
+endif()
+
 if(PS2X_ENABLE_AGRESSIVE_LOGS)
     target_compile_definitions(ps2_runtime PUBLIC
         AGRESSIVE_LOGS=1
