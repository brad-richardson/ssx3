+#if PS2X_ENABLE_DET_HASH_TAP
+// LX1b local-only RDRAM dumper (NEVER commit to the fork): when
+// PS2X_LX1B_RDUMP_DIR is set, writes DIR/rdram-<tick>.bin for ticks in
+// PS2X_LX1B_RDUMP_TICKS ("lo-hi"). Read-only w.r.t. guest state.
+namespace
+{
+void lx1bMaybeDumpRdram(uint64_t tick, const uint8_t *rdram, size_t size)
+{
+    static const char *dir = std::getenv("PS2X_LX1B_RDUMP_DIR");
+    static const char *win = std::getenv("PS2X_LX1B_RDUMP_TICKS");
+    if (!dir || !win || !rdram || size == 0)
+        return;
+    unsigned long long lo = 0, hi = 0;
+    if (std::sscanf(win, "%llu-%llu", &lo, &hi) != 2 || tick < lo || tick > hi)
+        return;
+    char path[1024];
+    std::snprintf(path, sizeof(path), "%s/rdram-%llu.bin", dir,
+                  static_cast<unsigned long long>(tick));
+    FILE *f = std::fopen(path, "wb");
+    if (!f)
+        return;
+    std::fwrite(rdram, 1, size, f);
+    std::fclose(f);
+    std::fprintf(stderr, "[lx1b-rdump] tick=%llu %s\n",
+                 static_cast<unsigned long long>(tick), path);
+}
+} // namespace
+#endif
