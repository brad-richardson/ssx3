+// N8X1 dev-only diagnostic knob, default = upstream behaviour.
+// PS2X_PGS_HIER=off: always flat binning. on: allow hierarchical binning on Apple too.
+// wave64 / wave128: hierarchical binning requires 64 / 128-wide subgroups.
+// fallback: upstream behaviour (free 4..128 subgroup range when 32 is unsupported).
+// Default (N8X1 candidate fix): try fixed 64 then 128 before the free-range fallback.
+static int n8x1_hier_mode()
+{
+	static const int mode = [] {
+		const char *env = getenv("PS2X_PGS_HIER");
+		int m = 0;
+		if (env && strcmp(env, "off") == 0)
+			m = 1;
+		else if (env && strcmp(env, "on") == 0)
+			m = 2;
+		else if (env && strcmp(env, "wave64") == 0)
+			m = 3;
+		else if (env && strcmp(env, "wave128") == 0)
+			m = 4;
+		else if (env && strcmp(env, "fallback") == 0)
+			m = 5;
+		LOGI("[n8x1] PS2X_PGS_HIER=%s mode=%d\n", env ? env : "(unset)", m);
+		return m;
+	}();
+	return mode;
+}
+
 uint32_t GSRenderer::get_target_hierarchical_binning(
 		uint32_t num_primitives, uint32_t coarse_tiles_width, uint32_t coarse_tiles_height) const
 {
+	const int n8x1_mode = n8x1_hier_mode();
+	if (n8x1_mode == 1)
+		return 1;
 #ifdef __APPLE__
 	// Broken Metal drivers can't deal with the hierarchical binning for some reason.
-	return 1;
+	if (n8x1_mode != 2)
+		return 1;
 #endif
 
 	// Only bother for large number of primitives.
@@ -2216,6 +2248,10 @@
 
 	// We cannot take good advantage of wave64 in the hierarchical binner, otherwise, we prefer large waves.
 	uint32_t size_log2 = is_hierarchical ? 5 : 6;
+	if (is_hierarchical && n8x1_hier_mode() == 3)
+		size_log2 = 6;
+	else if (is_hierarchical && n8x1_hier_mode() == 4)
+		size_log2 = 7;
 
 	while (size_log2 >= 2)
 	{
@@ -2230,7 +2266,31 @@
 		size_log2--;
 	}
 
+	// N8X1 candidate fix: a free subgroup range lets the driver pick a size the
+	// workgroup layout (wg = subgroupSize * hier^2) was not specialized for.
+	// Prefer a fixed larger size (Adreno: 64/128) over the free range.
+	if (n8x1_hier_mode() != 5)
+	{
+		for (uint32_t up_log2 = 6; up_log2 <= 7; up_log2++)
+		{
+			if (device->supports_subgroup_size_log2(true, up_log2, up_log2))
+			{
+				cmd.set_subgroup_size_log2(true, up_log2, up_log2);
+				uint32_t wg_size = std::min<uint32_t>(subgroup_size, 1u << up_log2);
+				cmd.set_specialization_constant(0, wg_size * hier_factor * hier_factor);
+				return;
+			}
+		}
+	}
+
 	// Fallback case, allow whatever.
+	static bool n8x1_logged = false;
+	if (!n8x1_logged)
+	{
+		n8x1_logged = true;
+		LOGI("[n8x1] hierarchical binning subgroup fallback: range 4..128, wg=%u (hier=%u)\n",
+		     subgroup_size * hier_factor * hier_factor, hier_factor);
+	}
 	cmd.set_subgroup_size_log2(true, 2, 7);
 	cmd.set_specialization_constant(0, subgroup_size * hier_factor * hier_factor);
 }
