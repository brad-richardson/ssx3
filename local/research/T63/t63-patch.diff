+	t63_dma_tw(host, base, end - base, via); // T63: template-array change watch (log-only).
+	for (int i = 0; i < 8; i++)
+	{
+		u32 w = g_t58_off[i];
+		if (w + 4 <= base || w >= end) continue;
+		u32 o = w - base;
+		u32 v = (u32)host[o] | ((u32)host[o + 1] << 8) | ((u32)host[o + 2] << 16) | ((u32)host[o + 3] << 24);
