 		}
 	}
+	else if (need_image_view_object &&
+	         device->get_device_features().descriptor_buffer_features.descriptorBuffer)
+	{
+		// G28 receipt: the new guard above skipped the branch (supports == 0).
+		static bool g28_skip_logged = false;
+		if (!g28_skip_logged)
+		{
+			g28_skip_logged = true;
+			LOGI("G28: create_image_view descriptorBuffer branch skipped (supports=0, feature=1).\n");
+		}
+	}
 
 	return true;
