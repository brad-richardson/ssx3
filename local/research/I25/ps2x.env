# I25 bundled defaults (copied into the .app as ps2x.env).
# A ps2x.env in the app's Documents folder (Files app > On My iPhone >
# SSX3 PS2X) overrides any key here; devicectl launch -e overrides both.
# ${BUNDLE} = the .app folder, ${DOCUMENTS} = the app's Documents folder.
PS2X_BOOT_ELF=${BUNDLE}/SLUS_207.72
PS2X_CD_IMAGE=${BUNDLE}/SSX3.iso
PS2X_MC_ROOT=${DOCUMENTS}/mc0
# Dev-only startup-movie bypass (approved, default off elsewhere).
PS2X_SKIP_MOVIE=1
PS2X_DEINTERLACE=weave
# Check-in mode: E33 vsync route, title -> Select Character -> Happiness
# race. Off: iOS Settings > SSX3 PS2X > Auto-route, or PS2X_PAD_SCRIPT=
# (empty) in Documents/ps2x.env.
PS2X_PAD_SCRIPT_CLOCK=vsync
PS2X_PAD_SCRIPT=10350:start:2500,20650:cross:2000,23200:cross:400,24000:cross:400,30890:cross:1700,39560:cross:1750,47240:down:4200,55450:cross:1800,64920:cross:2000,113340:cross:800,118270:cross:700,122510:cross:700,113340:down:20000
# No PS2X_FRAME_DUMP_DIR: PNG dumps stay off (a diagnostic cost).
