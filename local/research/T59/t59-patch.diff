+static int t58_phys(u32 vaddr, u32* out) // T59: segment-aware RAM fold.
+{
+	u32 seg = vaddr >> 24;
+	if ((seg == 0x00u || seg == 0x20u || seg == 0x30u || seg == 0x80u || seg == 0xA0u) &&
+		(vaddr & 0x00FFFFFFu) < 0x02000000u)
+	{
+		*out = vaddr & 0x01FFFFFFu;
+		return 1;
+	}
+	return 0;
+}
