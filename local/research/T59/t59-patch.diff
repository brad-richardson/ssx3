+void t58_dma_watch(u32 base, const u8* host, u32 bytes, const char* via, u32 src)
+{
+	t59_maybe_dump(); // T59: end-dump gate.
+	u32 end = base + bytes;
+	for (int i = 0; i < 8; i++)
+	{
+		u32 w = g_t58_off[i];
+		if (w + 4 <= base || w >= end) continue;
+		u32 o = w - base;
+		u32 v = (u32)host[o] | ((u32)host[o + 1] << 8) | ((u32)host[o + 2] << 16) | ((u32)host[o + 3] << 24);
+		t58_emit(i, v, via, src, base); // T59: DMA vaddr is the madr itself.
+	}
