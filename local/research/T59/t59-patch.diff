+static bool t50_gate()
+{
+	if (!g_t50_armed)
+	{
+		if ((++g_t50_arm_ctr & 1023) != 0) return false;
+		FILE* t50af = fopen("/tmp/t50-arm", "r");
+		if (!t50af) return false;
