+	else if (lo + size > 0x00435bf8 && lo < 0x00435c08) region = 1;
+	else if (pbase >= 0x004349b8 && pbase < 0x004349c8) region = 0;
+	else if (pbase >= 0x00435bf8 && pbase < 0x00435c08) region = 1;
+	else return;
